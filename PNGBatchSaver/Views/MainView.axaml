<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:PNGBatchSaver.ViewModels"
             mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="320"
             x:Class="PNGBatchSaver.Views.MainView"
             x:DataType="vm:MainViewModel"
             DragDrop.AllowDrop="True">
  <Design.DataContext>
    <vm:MainViewModel />
  </Design.DataContext>

  <Grid RowDefinitions="Auto,*,Auto" Margin="16">

    <!-- Compression level selector -->
    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,0,12">
      <TextBlock Text="PNG Compression Level:" VerticalAlignment="Center"/>
      <ComboBox ItemsSource="{Binding CompressionLevels}"
                SelectedItem="{Binding SelectedCompressionLevel}"
                IsEnabled="{Binding !IsProcessing}"
                MinWidth="60"/>
    </StackPanel>

    <!-- Drop zone -->
    <Border Grid.Row="1"
            BorderBrush="{DynamicResource SystemAccentColor}"
            BorderThickness="2"
            CornerRadius="8"
            Background="{DynamicResource SystemAltHighColor}">
      <Panel>
        <TextBlock Text="Drop PNG files here"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontSize="18"
                   Opacity="0.5"
                   IsVisible="{Binding !IsProcessing}"/>
        <TextBlock Text="Processing..."
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontSize="18"
                   IsVisible="{Binding IsProcessing}"/>
      </Panel>
    </Border>

    <!-- Status -->
    <TextBlock Grid.Row="2"
               Text="{Binding StatusText}"
               TextWrapping="Wrap"
               Margin="0,12,0,0"
               Opacity="0.8"/>
  </Grid>
</UserControl>
